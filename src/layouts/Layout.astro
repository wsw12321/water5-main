---
import "../styles/global.css";
import { siteMeta } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = siteMeta.title, description = siteMeta.description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? siteMeta.url);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#faf9f6" />
    <meta name="robots" content="index, follow" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="五水 / water5" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script is:inline>
      (() => {
        const root = document.documentElement;
        let saved = null;

        try {
          saved = window.localStorage.getItem("water5-theme");
        } catch {
          // Storage can be unavailable in privacy-restricted contexts.
        }

        const dark =
          saved === "light" || saved === "dark"
            ? saved === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;

        root.classList.add("js");
        root.dataset.theme = dark ? "dark" : "light";
      })();
    </script>

    <title>{title}</title>
  </head>
  <body>
    <slot />

    <script>
      type Theme = "light" | "dark";

      const storageKey = "water5-theme";
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
      const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

      function readSaved(): Theme | null {
        try {
          const saved = window.localStorage.getItem(storageKey);
          return saved === "light" || saved === "dark" ? saved : null;
        } catch {
          return null;
        }
      }

      function applyTheme(theme: Theme) {
        const dark = theme === "dark";
        root.dataset.theme = theme;
        themeColor?.setAttribute("content", dark ? "#121110" : "#faf9f6");

        if (toggle) {
          const label = dark ? "切换到浅色主题" : "切换到深色主题";
          toggle.setAttribute("aria-label", label);
          toggle.setAttribute("title", label);
          toggle.setAttribute("aria-pressed", String(dark));
        }
      }

      toggle?.addEventListener("click", () => {
        const next: Theme = root.dataset.theme === "dark" ? "light" : "dark";
        applyTheme(next);

        try {
          window.localStorage.setItem(storageKey, next);
        } catch {
          // The toggle still works for this visit without storage.
        }
      });

      systemDark.addEventListener("change", (event) => {
        if (!readSaved()) applyTheme(event.matches ? "dark" : "light");
      });

      applyTheme(root.dataset.theme === "dark" ? "dark" : "light");
    </script>
  </body>
</html>
