---
import { Image } from "astro:assets";
import avatarImage from "../assets/avatar.jpg";
import Icon from "../components/Icon.astro";
import type { IconName } from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import { experiences, profile, projects, siteMeta } from "../data/site";
import type { ExternalLink } from "../data/site";

const sections = [
  { id: "about", label: "关于" },
  { id: "experience", label: "经历" },
  { id: "projects", label: "项目" },
  { id: "contact", label: "联系" },
] as const;

type SectionId = (typeof sections)[number]["id"];

const linkIcons: Record<ExternalLink["kind"], IconName> = {
  email: "mail",
  profile: "github",
  website: "globe",
  repository: "code",
};

const isExternal = (link: ExternalLink) => link.href.startsWith("http");
const externalAttrs = (link: ExternalLink) =>
  isExternal(link) ? { target: "_blank", rel: "noopener noreferrer" } : {};
const sectionIndex = (id: SectionId) =>
  String(sections.findIndex((section) => section.id === id) + 1).padStart(2, "0");
const year = new Date().getFullYear();
---

<Layout title={siteMeta.title} description={siteMeta.description}>
  <a class="skip-link" href="#main">跳到正文</a>

  <header class="site-header" data-header>
    <div class="wrap header-inner">
      <a class="brand" href="#top" aria-label={`${profile.name} ${profile.handle}，回到顶部`}>
        <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2.5c-2.9 4-6.5 7.3-6.5 11.6a6.5 6.5 0 0 0 13 0C18.5 9.8 14.9 6.5 12 2.5Z" />
        </svg>
        <span class="brand-name">{profile.name}</span>
        <span class="brand-handle">{profile.handle}</span>
      </a>

      <div class="header-actions">
        <nav class="nav" aria-label="主导航">
          {sections.map((section) => (
            <a href={`#${section.id}`} data-nav-link>{section.label}</a>
          ))}
        </nav>

        <button
          class="theme-toggle"
          type="button"
          data-theme-toggle
          aria-label="切换到深色主题"
          aria-pressed="false"
        >
          <Icon name="moon" size={18} class="theme-icon-moon" />
          <Icon name="sun" size={18} class="theme-icon-sun" />
        </button>
      </div>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <section class="wrap hero" id="top" aria-labelledby="hero-title">
      <div class="hero-text">
        <p class="hero-greeting rise">你好，我是</p>
        <h1 id="hero-title" class="rise" style="--i: 1">
          {profile.name}
          <span class="hero-handle">{profile.handle}</span>
        </h1>
        <p class="hero-role rise" style="--i: 2">{profile.role}</p>
        <p class="hero-intro rise" style="--i: 3">{profile.intro}</p>

        <ul class="hero-links rise" style="--i: 4" aria-label="联系方式">
          {profile.contacts.map((link) => (
            <li>
              <a class="pill" href={link.href} {...externalAttrs(link)}>
                <Icon name={linkIcons[link.kind]} />
                {link.label}
                {isExternal(link) && <span class="sr-only">（在新窗口打开）</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="hero-avatar rise" style="--i: 2">
        <Image
          src={avatarImage}
          alt="五水的头像：系着橙色围巾、胸前挂着“五水”名牌的白色垂耳兔插画"
          widths={[96, 192, 240, 432]}
          sizes="(max-width: 760px) 96px, 216px"
          format="webp"
          quality={88}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </section>

    <section class="wrap section" id="about" aria-labelledby="about-title">
      <header class="section-label">
        <span class="section-index" aria-hidden="true">{sectionIndex("about")}</span>
        <h2 id="about-title">关于</h2>
      </header>

      <div class="section-body">
        <p class="about-lead">{profile.background}</p>

        <blockquote class="principle">
          <p>{profile.principle}</p>
        </blockquote>

        <dl class="skills">
          {profile.skills.map((group) => (
            <div class="skill-row">
              <dt>{group.label}</dt>
              <dd>
                <ul class="chips">
                  {group.items.map((item) => <li>{item}</li>)}
                </ul>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="wrap section" id="experience" aria-labelledby="experience-title">
      <header class="section-label">
        <span class="section-index" aria-hidden="true">{sectionIndex("experience")}</span>
        <h2 id="experience-title">经历</h2>
      </header>

      <ol class="section-body timeline">
        {experiences.map((item) => (
          <li class="timeline-item">
            <p class="timeline-period">{item.period}</p>
            <div class="timeline-content">
              <h3>{item.title}</h3>
              <p class="timeline-org">{item.organization}</p>
              <p class="timeline-desc">{item.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="wrap section" id="projects" aria-labelledby="projects-title">
      <header class="section-label">
        <span class="section-index" aria-hidden="true">{sectionIndex("projects")}</span>
        <h2 id="projects-title">项目</h2>
      </header>

      <div class="section-body project-list">
        {projects.map((project) => (
          <article
            class:list={["project", { "project--featured": project.image }]}
            aria-labelledby={`project-${project.number}`}
          >
            {project.image && (
              <figure class="project-media">
                <Image
                  src={project.image.src}
                  alt={project.image.alt}
                  widths={[480, 720, 960, 1400]}
                  sizes="(max-width: 760px) calc(100vw - 58px), 700px"
                  format="webp"
                  quality={84}
                  loading="lazy"
                />
              </figure>
            )}

            <div class="project-body">
              <p class="project-meta">
                <span>{project.category}</span>
                <span aria-hidden="true">{project.number}</span>
              </p>
              <h3 id={`project-${project.number}`}>{project.title}</h3>
              <p class="project-desc">{project.description}</p>

              {project.highlights && (
                <ul class="project-points" aria-label="我的工作">
                  {project.highlights.map((highlight) => <li>{highlight}</li>)}
                </ul>
              )}

              <div class="project-footer">
                <ul class="tags" aria-label="技术标签">
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>

                {project.links.length > 0 && (
                  <ul class="project-links" aria-label="相关链接">
                    {project.links.map((link) => (
                      <li>
                        <a href={link.href} {...externalAttrs(link)}>
                          {link.label}
                          <Icon name="arrow-up-right" size={14} />
                          {isExternal(link) && <span class="sr-only">（在新窗口打开）</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="wrap section" id="contact" aria-labelledby="contact-title">
      <header class="section-label">
        <span class="section-index" aria-hidden="true">{sectionIndex("contact")}</span>
        <h2 id="contact-title">联系</h2>
      </header>

      <div class="section-body">
        <p class="contact-lead">项目、技术或有趣的工具，都欢迎聊聊。</p>

        <ul class="contact-list">
          {profile.contacts.map((link) => (
            <li>
              <a href={link.href} {...externalAttrs(link)}>
                <Icon name={linkIcons[link.kind]} size={18} class="contact-icon" />
                <span class="contact-text">
                  <span class="contact-label">{link.label}</span>
                  <span class="contact-value">{link.display ?? link.href}</span>
                </span>
                <Icon name="arrow-up-right" size={16} class="contact-arrow" />
                {isExternal(link) && <span class="sr-only">（在新窗口打开）</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <p>© {year} {profile.name} · {profile.handle}</p>
      <a href="#top">
        回到顶部
        <Icon name="arrow-up" size={14} />
      </a>
    </div>
  </footer>

  <script>
    const header = document.querySelector<HTMLElement>("[data-header]");
    const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"));
    const targets = navLinks
      .map((link) => ({ link, section: document.getElementById(link.hash.slice(1)) }))
      .filter((item): item is { link: HTMLAnchorElement; section: HTMLElement } => item.section !== null);

    let queued = false;

    function sync() {
      queued = false;
      header?.toggleAttribute("data-scrolled", window.scrollY > 4);

      const marker = window.innerHeight * 0.35;
      const atBottom =
        window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      let active: HTMLAnchorElement | null = null;

      for (const { link, section } of targets) {
        if (section.getBoundingClientRect().top <= marker) active = link;
      }

      if (atBottom && targets.length > 0) active = targets[targets.length - 1].link;

      for (const { link } of targets) {
        if (link === active) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      }
    }

    function queueSync() {
      if (queued) return;
      queued = true;
      window.requestAnimationFrame(sync);
    }

    window.addEventListener("scroll", queueSync, { passive: true });
    window.addEventListener("resize", queueSync);
    sync();
  </script>
</Layout>
